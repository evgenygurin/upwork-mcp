# ─── Upwork Credentials ───────────────────────────────────────────────────────
UPWORK_EMAIL=your@email.com
UPWORK_PASSWORD=yourpassword

# ─── Upwork OAuth API (optional — for stats/earnings) ─────────────────────────
# Get from https://www.upwork.com/developer/keys/list
UPWORK_API_KEY=
UPWORK_API_SECRET=
UPWORK_ACCESS_TOKEN=
UPWORK_ACCESS_SECRET=

# ─── Residential Proxy ────────────────────────────────────────────────────────
# When set, the server uses its own Playwright browser (stealth mode) instead
# of connecting via CDP. Session cookies are saved/loaded automatically, so
# login only happens once. Residential proxies bypass Upwork's datacenter IP blocks.
#
# Format:  http://user:pass@host:port
#          socks5://user:pass@host:port
# Providers: BrightData, Smartproxy, Oxylabs, IPRoyal, Webshare
#
PROXY_URL=
PROXY_BYPASS=localhost,127.0.0.1

# ─── Browser Config ───────────────────────────────────────────────────────────
# headless=true for Docker, false for local debug
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=50

# ─── Session Storage ──────────────────────────────────────────────────────────
SESSION_FILE=./sessions/upwork-session.json

# ─── Freelancer Profile ───────────────────────────────────────────────────────
# Dùng để agent tự điều chỉnh proposal
FREELANCER_NAME=Your Name
FREELANCER_TITLE=n8n Workflow Automation Expert
FREELANCER_NICHE=n8n,workflow automation,make.com,zapier,api integration

# ─── Agent Behavior ───────────────────────────────────────────────────────────
# Min/max bid rate (USD/hr) để agent tự chọn giá hợp lý
BID_RATE_MIN=25
BID_RATE_MAX=75
BID_RATE_DEFAULT=40
